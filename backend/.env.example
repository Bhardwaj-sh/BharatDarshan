# ==========================================
# Bharat Darshan Backend Environment Config
# ==========================================

# Server Port and Environment Mode
PORT=5000
NODE_ENV=development

# Client Frontend URLs for CORS Whitelist (comma-separated for multiple origins)
# e.g., in production: https://bharatdarshan.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Database Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bharat_darshan?retryWrites=true&w=majority

# JWT Authentication Secrets (Use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
